// ─────────────────────────────────────────────────────────────
// firestore.rules — ปิดอ่าน/เขียนทั้งหมดชั่วคราว (ล็อกไว้ก่อน)
//
// ⚠️ พบว่า project นี้มีข้อมูลจริงของบุคคล (ชื่อ-อีเมลจริงของผู้เรียน)
// ค้างอยู่ในโฟลเดอร์ users/leaveRequests จากการทดลองครั้งก่อน
// จึงปิดการอ่านแบบสาธารณะไว้ก่อนเพื่อไม่ให้ข้อมูลจริงถูกเปิดอ่านได้
// จากอินเทอร์เน็ต จนกว่าจะตัดสินใจว่าจะจัดการข้อมูลชุดนั้นอย่างไร
// (ดูรายงานของ leaveeasy-builder ประกอบ)
//
// เดิมตั้งใจให้เป็นกฎชั่วคราวของสัปดาห์ 6: allow read: if true (เปิดอ่าน
// อย่างเดียว เพราะสัปดาห์ 6 ยังไม่มีล็อกอิน) แต่ถูกพักไว้ก่อนตามเหตุผลข้างต้น
//
// กฎนี้จะถูกแทนที่ด้วย:
//   - สัปดาห์ที่ 7: ต้องล็อกอินก่อนถึงอ่าน/เขียนได้
//   - สัปดาห์ที่ 8: กฎรายห้องครบชุดตามบทบาท employee / manager / hr
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
