// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของสัปดาห์ที่ 7: ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้
//
// แก้บั๊กสัปดาห์ที่ 9 (เทสต์จับได้): ก่อนหน้านี้กฎถูกทับกลับไปเป็นเวอร์ชัน
// สัปดาห์ 6 (allow write: if false) ทำให้สมัครสมาชิก (เขียน users/{uid})
// และยื่นใบลาใหม่ (เขียน leaveRequests) ล้มเหลวด้วย "Missing or
// insufficient permissions." สำหรับผู้ใช้ทุกคนที่ล็อกอินอยู่จริง
//
// กฎนี้ครอบทุกโฟลเดอร์รวม subcollection (approvals, aiLog ฯลฯ)
// ด้วย match /{document=**}
//
// ยังไม่ใช่กฎรายห้องตามบทบาท employee / manager / hr — นั่นคือ
// "เช็กลิสต์ 5 ข้อ" ของสัปดาห์ที่ 8 ซึ่งต้องตรวจ/ทำผ่าน leaveeasy-reviewer
// แยกต่างหาก ไม่ใช่ส่วนของการแก้บั๊กนี้
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
