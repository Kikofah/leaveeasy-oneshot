// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎชั่วคราวของสัปดาห์ที่ 6: เปิดอ่านอย่างเดียว
//
// สัปดาห์ 6 ยังไม่มีล็อกอิน (Firebase Authentication เริ่มสัปดาห์ 7)
// จึงเปิดให้อ่านได้แบบสาธารณะชั่วคราว เพื่อให้หน้ารายการ (US-01)
// อ่านข้อมูลตัวอย่างจริงจาก Firestore ได้ — ห้ามเขียนจากฝั่งเว็บเลย
//
// กฎนี้จะถูกแทนที่ด้วย:
//   - สัปดาห์ที่ 7: ต้องล็อกอินก่อนถึงอ่าน/เขียนได้
//   - สัปดาห์ที่ 8: กฎรายห้องครบชุดตามบทบาท employee / manager / hr
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
